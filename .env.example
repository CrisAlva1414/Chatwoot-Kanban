# ── Chatwoot ──────────────────────────────────────────
CHATWOOT_BASE_URL=https://tu-instancia.chatwoot.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_BOT_TOKEN=tu_bot_token_aqui

# ── Postgres ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://kanban:kanban_password@ruki-kanban-postgres:5432/kanban
POSTGRES_PASSWORD=kanban_password

# ── Entorno ────────────────────────────────────────────
ENV=production
# ── Puerto interno (usa 8000, no se expone) ─────────
PORT=8000

# ── Cloudflare Access (opcional) ──────────────────────
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
