# ── Chatwoot ──────────────────────────────────────────
CHATWOOT_BASE_URL=https://your-instance.chatwoot.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_BOT_TOKEN=your_bot_token_here
CHATWOOT_BOT_EMAIL=bot@example.com
CHATWOOT_FRONTEND_URL=

# ── Postgres ──────────────────────────────────────────
# Option A: direct URL (classic format)
# DATABASE_URL=postgresql://kanban:password@chatwoot-kanban-db:5432/kanban
#
# Option B: individual fields (URL is built automatically)
POSTGRES_USER=kanban
POSTGRES_PASSWORD=kanban_password
POSTGRES_DB=kanban
POSTGRES_HOST=chatwoot-kanban-db
POSTGRES_PORT=5432

# ── Environment ───────────────────────────────────────
ENV=production
PORT=8000

# ── Webhook (optional) ──────────────────────────────
CHATWOOT_WEBHOOK_SECRET=

# ── Cloudflare Access (optional) ──────────────────────
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
