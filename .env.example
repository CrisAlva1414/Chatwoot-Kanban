# ── Chatwoot ──────────────────────────────────────────
CHATWOOT_BASE_URL=https://tu-instancia.chatwoot.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_BOT_TOKEN=tu_bot_token_aqui

# ── Postgres ──────────────────────────────────────────
POSTGRES_USER=kanban
POSTGRES_PASSWORD=kanban_password
POSTGRES_DB=kanban
POSTGRES_HOST=ruki-kanban-postgres
POSTGRES_PORT=5432

# ── Entorno ────────────────────────────────────────────
ENV=production
# ── Puerto interno (usa 8000, no se expone) ─────────
PORT=8000

# ── Webhook (opcional) ──────────────────────────────
CHATWOOT_WEBHOOK_SECRET=

# ── Cloudflare Access (opcional) ──────────────────────
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
